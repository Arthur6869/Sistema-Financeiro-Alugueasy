# Copie este arquivo para `.env` e preencha.
#
# O prefixo EXPO_PUBLIC_ faz o valor ser embutido no aplicativo. Portanto:
# NUNCA coloque aqui a service role key nem a chave interna da API.
#
# A chave abaixo é a publicável (antiga "anon"). Ela é pública por desenho — só
# identifica o projeto, não autoriza nada. Quem protege os dados é a RLS.
EXPO_PUBLIC_SUPABASE_URL=https://rlkmljeatapayiroggrp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_publicavel

# URL do sistema web, usada para baixar PDFs de prestação de contas.
EXPO_PUBLIC_API_BASE_URL=https://sistema-financeiro-alugueasy.vercel.app
